{
  "name": "love2d-mcp",
  "version": "2.1.0",
  "description": "Security-hardened MCP bridge for L\u00d6VE2D game development",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "love2d-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "start": "node --env-file=.env build/index.js",
    "setup": "node scripts/setup.mjs",
    "game": "node scripts/launch-game.mjs",
    "test:lua": "lua tests/bridge.test.lua"
  },
  "keywords": [
    "mcp",
    "love2d",
    "love",
    "game-development",
    "security",
    "codex"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "typescript": "5.8.3"
  },
  "files": [
    "build",
    "game",
    "scripts",
    "README.md",
    "README.ko.md",
    "SECURITY.md",
    "EXAMPLES.md",
    "LICENSE"
  ]
}
